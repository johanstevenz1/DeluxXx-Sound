{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DeluxXx: iniciar frontend y backend",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/dev.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "deluxxx",
        "pattern": {
          "regexp": "^ERROR (.*):([0-9]+):([0-9]+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "DELUXXX_READY .*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "DeluxXx: compilar",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
